# Leave MSSQL_SERVER empty to run without database persistence.
# Example local SQL Express configuration:
# MSSQL_SERVER=DESKTOP-U1FHBEI\\SQLEXPRESS
# MSSQL_DATABASE=KepwareMonitor
# MSSQL_TRUSTED_CONNECTION=true
MSSQL_SERVER=
MSSQL_DATABASE=
MSSQL_USERNAME=
MSSQL_PASSWORD=
MSSQL_DRIVER=ODBC Driver 18 for SQL Server
MSSQL_TRUSTED_CONNECTION=true
MSSQL_TRUST_SERVER_CERTIFICATE=true
MONITOR_INTERVAL_SECONDS=15
SNAPSHOT_INTERVAL_MINUTES=15

# Gmail STOPPED-transition alerts (STARTTLS on smtp.gmail.com:587).
# Put real values only in .env (git-ignored). SMTP_PASSWORD must be a Gmail App Password,
# never your normal Gmail password. ALERT_RECIPIENT is accepted as an alias for ALERT_TO.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=<sender-address@gmail.com>
SMTP_PASSWORD=<MY_GMAIL_APP_PASSWORD>
ALERT_FROM=<sender-address@gmail.com>
ALERT_TO=<recipient-address@example.com>
# Initial email kill-switch position. The dashboard toggle (saved in data/alert_settings.json) overrides it.
EMAIL_ALERTS_ENABLED=true
